@import url('https://fonts.googleapis.com/css2?family=Amiri+Quran&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html, body {
    @apply h-full overflow-x-hidden bg-white text-slate-800 antialiased selection:bg-blue-100 selection:text-blue-800 dark:bg-slate-950 dark:text-slate-200 dark:selection:bg-blue-900 dark:selection:text-blue-100;
    font-family: 'Outfit', 'Inter', system-ui, -apple-system, sans-serif;
  }
  
  /* Customized premium scrollbar for modern theme */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  
  ::-webkit-scrollbar-track {
    @apply bg-slate-50 dark:bg-slate-900;
  }
  
  ::-webkit-scrollbar-thumb {
    @apply bg-slate-200 dark:bg-slate-700 rounded-full hover:bg-slate-300 dark:hover:bg-slate-600 transition-colors;
  }
}

/* Typography styles for Arabic and religious modules */
.font-arabic {
  font-family: 'Amiri Quran', 'Scheherazade New', 'Amiri', 'Traditional Arabic', serif;
  direction: rtl;
  line-height: 2.2;
}

html.font-amiri, html.font-amiri body, html.font-amiri * {
  font-family: 'Amiri', serif !important;
}

/* Micro-interaction utility transitions */
.transition-premium {
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Focus ring styles */
input:not([type="radio"]):not([type="checkbox"]):focus, button:focus-visible {
  outline: 2px solid #2563EB;
  outline-offset: 2px;
}

/* Hide mobile bottom navigation bar and floating menu pill when layout/pages demand it */
html.hide-mobile-nav #mobile-bottom-nav,
html.hide-mobile-nav #mobile-menu-pill {
  display: none !important;
}


/* Hide number input spinners globally */
input[type="number"]::-webkit-inner-spin-button,
input[type="number"]::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
input[type="number"] {
  -moz-appearance: textfield;
}
